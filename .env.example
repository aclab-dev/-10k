# =====================================================================
# crypto-futures-gpt55-bot - Variables de entorno
# =====================================================================
# Copiar este archivo a .env y completar con valores reales.
# .env nunca debe commitearse (esta en .gitignore).
#
# Todas las variables necesarias para ejecutar el bot estan aqui.
# Las marcadas como REQUERIDO deben tener valor antes de levantar el servicio.

# ---------------------------------------------------------------------
# Entorno de ejecucion
# ---------------------------------------------------------------------
# PAPER es el unico valor permitido por defecto.
# TESTNET solo cuando exista ExchangeAdapter verificado.
# LIVE requiere ademas I_UNDERSTAND_LIVE_RISK=YES (no habilitar todavia).
ENVIRONMENT=PAPER

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=bot
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=cryptobot

# Connection string usado por la app y el worker.
# El host "postgres" coincide con el nombre del servicio en docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://bot:changeme_local_only@postgres:5432/cryptobot

# ---------------------------------------------------------------------
# FastAPI app
# ---------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# Nivel de log. Valores validos: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# En produccion usar WARNING o ERROR para reducir volumen.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------
# Intervalo entre heartbeats (segundos). Solo loguea, no opera.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# Espera antes de salir cuando el worker pierde una carrera de arranque
# concurrente (F16 [114], BotRunAlreadyActiveError). docker-compose lo va a
# reiniciar igual (restart: unless-stopped) -- esto solo espacia esos
# reintentos en vez de dejarlos ir cada pocos segundos.
WORKER_STARTUP_RACE_BACKOFF_SECONDS=300

# ---------------------------------------------------------------------
# OpenAI (GPT-5.5 — evaluador contextual)
# REQUERIDO para que el Decision Aggregator funcione.
# Obtener en: https://platform.openai.com/api-keys
# La key NUNCA debe tener permisos de billing ni de org admin.
# ---------------------------------------------------------------------
OPENAI_API_KEY=

# Modelo a usar. Cambiar solo si la spec indica una version distinta.
OPENAI_MODEL=gpt-4o

# Limite de tokens por request (budget control). Ajustar segun tarjeta F-token-budget.
OPENAI_MAX_TOKENS=2000

# ---------------------------------------------------------------------
# BingX (exchange principal — futuros USDT-M)
# REQUERIDO para PAPER/TESTNET/LIVE.
# Crear una API key sin permiso de retiro en: https://bingx.com/en-us/account/api
# Permisos necesarios: Read + Trade. Retiro: DESHABILITADO obligatorio.
# ---------------------------------------------------------------------
BINGX_API_KEY=
BINGX_API_SECRET=

# ---------------------------------------------------------------------
# Binance (exchange secundario — fallback)
# Opcional en PAPER. REQUERIDO si se habilita secondary_exchange en config.yaml.
# Crear key sin permiso de retiro en: https://www.binance.com/en/my/settings/api-management
# Permisos necesarios: Read + Futures Trade. Retiro: DESHABILITADO obligatorio.
# ---------------------------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------------------------------------------------------------------
# Confirmacion LIVE (doble llave de seguridad)
# REQUERIDO para que ENVIRONMENT=LIVE sea aceptado por el Risk Engine.
# Sin esta variable con valor YES, el bot rechaza operar en LIVE.
# Dejar vacia hasta completar el checklist LIVE del PDF maestro.
# ---------------------------------------------------------------------
I_UNDERSTAND_LIVE_RISK=

# ---------------------------------------------------------------------
# Auth del dashboard (F15)
# REQUERIDO mientras dashboard_auth.enabled sea true en config.yaml.
# Si falta cualquiera de las tres, la app NO levanta (fail-closed).
#
# Generar el hash y la secret key con:
#   python scripts/hash_password.py
#
# La password en claro NO va en este archivo ni en ningun otro: solo su hash.
# ---------------------------------------------------------------------
DASHBOARD_USERNAME=admin

# Hash scrypt de la password. Formato: scrypt$n$r$p$salt$hash
#
# IMPORTANTE: cada '$' literal debe escaparse como '$$'. Docker Compose interpola
# este archivo y sin escapar trata cada segmento después de un '$' como el nombre
# de otra variable, la reemplaza por string vacio y corrompe el hash (la app
# rechaza el resultado con "formato invalido" y el container queda crash-looping).
# scripts/hash_password.py ya imprime el valor escapado: pegalo tal cual, sin
# desescapar.
DASHBOARD_PASSWORD_HASH=

# Clave HMAC con la que se firman los tokens de sesion. Minimo 32 caracteres.
# Cambiarla invalida todas las sesiones activas.
DASHBOARD_SECRET_KEY=

# =====================================================================
# Overrides de config.yaml via env vars (prefijo BOT__ + separador __)
# =====================================================================
# Todos los valores de config.yaml pueden sobreescribirse siguiendo el
# patron: BOT__<SECCION>__<CAMPO>=<VALOR>
# Los valores de config.yaml se usan como default si la var no esta presente.

# --- Ejecucion --------------------------------------------------------
# Entorno activo. PAPER es el default obligatorio.
# BOT__EXECUTION__ENVIRONMENT=PAPER

# --- Risk / Margenes --------------------------------------------------
# Margen maximo por operacion en USDT. Limite absoluto: 10.
# BOT__RISK__MAX_MARGIN_PER_TRADE_USDT=10
# BOT__CHALLENGE__MAX_MARGIN_PER_TRADE_USDT=10

# --- Leverage ---------------------------------------------------------
# Maximos por entorno. No pueden superar los limites del PDF.
# BOT__LEVERAGE__MAX_LEVERAGE_PAPER=10        # tope: 10
# BOT__LEVERAGE__MAX_LEVERAGE_TESTNET=5       # tope: 5
# BOT__LEVERAGE__MAX_LEVERAGE_LIVE_INITIAL=3  # tope: 3
# BOT__LEVERAGE__MAX_LEVERAGE_LIVE_ABSOLUTE=5 # tope: 5

# --- Confianza minima -------------------------------------------------
# BOT__RISK__MIN_CONFIDENCE_PAPER=0.70
# BOT__RISK__MIN_CONFIDENCE_TESTNET=0.75
# BOT__RISK__MIN_CONFIDENCE_LIVE=0.80

# --- Posiciones abiertas ----------------------------------------------
# BOT__TRADING__MAX_OPEN_POSITIONS=1
# BOT__TRADING__MAX_OPEN_POSITIONS_ALLOWED=3  # tope: 3

# --- Salud de conexion / reloj (F16 [117]) -----------------------------
# Umbrales de alerta temprana, deben quedar por debajo del bound duro de
# MarketSnapshot (5000ms / 10000ms) o nunca se dispararian.
# BOT__CONNECTION_HEALTH__MAX_CLOCK_SKEW_MS=2000
# BOT__CONNECTION_HEALTH__MAX_LATENCY_MS=3000

# --- Gestion de posicion ----------------------------------------------
# Distancia que dispara el break-even, como multiplo del ATR(1h) al abrir.
# BOT__POSITION_MANAGEMENT__BE_TRIGGER_ATR_MULTIPLIER=1.0
# Buffer del break-even para cubrir fees, como porcentaje del entry_price.
# BOT__POSITION_MANAGEMENT__BE_SL_OFFSET_PERCENT=0.0015

# --- Storage / Auditoria ----------------------------------------------
# BOT__STORAGE__LOG_ALL_DECISIONS=true
# BOT__STORAGE__LOG_MODEL_REQUESTS=true
# BOT__STORAGE__LOG_MODEL_RESPONSES=true

# --- Auth del dashboard -----------------------------------------------
# Deshabilitar la auth deja los endpoints de estado, PnL, decisiones y tokens
# accesibles sin credenciales. Solo para desarrollo local.
# BOT__DASHBOARD_AUTH__ENABLED=true
# BOT__DASHBOARD_AUTH__TOKEN_TTL_SECONDS=43200

# --- Rate limiting del login (F15) ------------------------------------
# Frena el brute-force contra POST /api/auth/login. Deshabilitarlo deja el
# endpoint aceptando intentos ilimitados: solo para desarrollo local.
# BOT__DASHBOARD_AUTH__LOGIN_THROTTLE__ENABLED=true
# BOT__DASHBOARD_AUTH__LOGIN_THROTTLE__MAX_FAILURES_PER_USERNAME=5
# BOT__DASHBOARD_AUTH__LOGIN_THROTTLE__MAX_FAILURES_PER_IP=10
# BOT__DASHBOARD_AUTH__LOGIN_THROTTLE__WINDOW_SECONDS=900
# BOT__DASHBOARD_AUTH__LOGIN_THROTTLE__LOCKOUT_SECONDS=300
# BOT__DASHBOARD_AUTH__LOGIN_THROTTLE__LOCKOUT_BACKOFF_FACTOR=2.0
# BOT__DASHBOARD_AUTH__LOGIN_THROTTLE__MAX_LOCKOUT_SECONDS=3600

# Requisito de infra del limite por IP: uvicorn solo aplica X-Forwarded-For si
# el peer esta en FORWARDED_ALLOW_IPS (default 127.0.0.1). Detras de un reverse
# proxy que no sea localhost desde la perspectiva de uvicorn (otro contenedor,
# otro host), hay que setearlo con la direccion del proxy. Sin eso, todos los
# clientes comparten la IP del proxy y unos pocos fallos bloquean a todos.
# Nunca "*": habilita a cualquiera a falsear su IP y saltearse el limite.
# FORWARDED_ALLOW_IPS=127.0.0.1
