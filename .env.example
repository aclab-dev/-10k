# =====================================================================
# crypto-futures-gpt55-bot - Variables de entorno
# =====================================================================
# Copiar este archivo a .env y completar con valores reales.
# .env nunca debe commitearse (esta en .gitignore).
#
# Esta version cubre lo minimo para `docker compose up`.
# Las variables completas (API keys, GPT, risk params) se agregan
# en tarjetas posteriores de Fase 2.

# ---------------------------------------------------------------------
# Entorno de ejecucion
# ---------------------------------------------------------------------
# PAPER es el unico valor permitido por defecto.
# TESTNET solo cuando exista ExchangeAdapter verificado.
# LIVE requiere ademas I_UNDERSTAND_LIVE_RISK=YES (no habilitar todavia).
ENVIRONMENT=PAPER

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=bot
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=cryptobot

# Connection string usado por la app y el worker.
# El host "postgres" coincide con el nombre del servicio en docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://bot:changeme_local_only@postgres:5432/cryptobot

# ---------------------------------------------------------------------
# FastAPI app
# ---------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------
# Intervalo entre heartbeats (segundos). Solo loguea, no opera.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
