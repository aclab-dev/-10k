# =====================================================================
# crypto-futures-gpt55-bot - Variables de entorno
# =====================================================================
# Copiar este archivo a .env y completar con valores reales.
# .env nunca debe commitearse (esta en .gitignore).
#
# Esta version cubre lo minimo para `docker compose up`.
# Las variables completas (API keys, GPT, risk params) se agregan
# en tarjetas posteriores de Fase 2.

# ---------------------------------------------------------------------
# Entorno de ejecucion
# ---------------------------------------------------------------------
# PAPER es el unico valor permitido por defecto.
# TESTNET solo cuando exista ExchangeAdapter verificado.
# LIVE requiere ademas I_UNDERSTAND_LIVE_RISK=YES (no habilitar todavia).
ENVIRONMENT=PAPER

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_USER=bot
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=cryptobot

# Connection string usado por la app y el worker.
# El host "postgres" coincide con el nombre del servicio en docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://bot:changeme_local_only@postgres:5432/cryptobot

# ---------------------------------------------------------------------
# FastAPI app
# ---------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------
# Intervalo entre heartbeats (segundos). Solo loguea, no opera.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# =====================================================================
# Overrides de config.yaml via env vars (prefijo BOT__ + separador __)
# =====================================================================
# Todos los valores de config.yaml pueden sobreescribirse siguiendo el
# patron: BOT__<SECCION>__<CAMPO>=<VALOR>
# Los valores de config.yaml se usan como default si la var no esta presente.

# --- Ejecucion --------------------------------------------------------
# Entorno activo. PAPER es el default obligatorio.
# BOT__EXECUTION__ENVIRONMENT=PAPER

# --- Confirmacion LIVE (requiere TAMBIEN BOT__EXECUTION__ENVIRONMENT=LIVE) ---
# Sin esta variable, LIVE queda bloqueado aunque se cambie el entorno.
# I_UNDERSTAND_LIVE_RISK=YES

# --- Risk / Margenes --------------------------------------------------
# Margen maximo por operacion en USDT. Limite absoluto: 10.
# BOT__RISK__MAX_MARGIN_PER_TRADE_USDT=10
# BOT__CHALLENGE__MAX_MARGIN_PER_TRADE_USDT=10

# --- Leverage ---------------------------------------------------------
# Maximos por entorno. No pueden superar los limites del PDF.
# BOT__LEVERAGE__MAX_LEVERAGE_PAPER=10        # tope: 10
# BOT__LEVERAGE__MAX_LEVERAGE_TESTNET=5       # tope: 5
# BOT__LEVERAGE__MAX_LEVERAGE_LIVE_INITIAL=3  # tope: 3
# BOT__LEVERAGE__MAX_LEVERAGE_LIVE_ABSOLUTE=5 # tope: 5

# --- Confianza minima -------------------------------------------------
# BOT__RISK__MIN_CONFIDENCE_PAPER=0.70
# BOT__RISK__MIN_CONFIDENCE_TESTNET=0.75
# BOT__RISK__MIN_CONFIDENCE_LIVE=0.80

# --- Posiciones abiertas ----------------------------------------------
# BOT__TRADING__MAX_OPEN_POSITIONS=1
# BOT__TRADING__MAX_OPEN_POSITIONS_ALLOWED=3  # tope: 3

# --- Storage / Auditoria ----------------------------------------------
# BOT__STORAGE__LOG_ALL_DECISIONS=true
# BOT__STORAGE__LOG_MODEL_REQUESTS=true
# BOT__STORAGE__LOG_MODEL_RESPONSES=true
